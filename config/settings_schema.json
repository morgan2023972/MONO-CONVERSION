[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Tunnel & CRM",
    "settings": [
      {
        "type": "checkbox",
        "id": "funnel_mode_enabled",
        "label": "Enable funnel mode",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "analytics_debug",
        "label": "Enable analytics debug logs",
        "default": false
      },
      {
        "type": "url",
        "id": "brevo_event_endpoint",
        "label": "Brevo event relay endpoint"
      },
      {
        "type": "text",
        "id": "ai_copy_source",
        "label": "AI copy source",
        "default": "pipeline:brevo+ia"
      },
      {
        "type": "text",
        "id": "ai_copy_last_sync",
        "label": "AI copy last sync"
      }
    ]
  },
  {
    "name": "SEO Funnel",
    "settings": [
      {
        "type": "text",
        "id": "seo_funnel_home_title",
        "label": "Funnel home title"
      },
      {
        "type": "textarea",
        "id": "seo_funnel_home_description",
        "label": "Funnel home description"
      },
      {
        "type": "text",
        "id": "seo_funnel_product_title_suffix",
        "label": "Product title suffix",
        "default": "Offre exclusive"
      },
      {
        "type": "textarea",
        "id": "seo_funnel_product_description",
        "label": "Product fallback description"
      },
      {
        "type": "checkbox",
        "id": "seo_noindex_cart",
        "label": "Noindex cart page",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "seo_funnel_og_image",
        "label": "Funnel social image"
      }
    ]
  }
]
