{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<h1>{{ 'cart.title' | t }}</h1>
{% if section.settings.cart_reassurance != blank %}
  <p>{{ section.settings.cart_reassurance }}</p>
{% endif %}

<form action="{{ routes.cart_url }}" method="post">
  <table>
    {% for item in cart.items %}
      <tr>
        <td>
          {% render 'image', image: item.image, url: item.url %}
        </td>
        <td>
          <p>{{ item.product.title }}</p>
          {{ 'cart.remove' | t | link_to: item.url_to_remove }}
        </td>
        <td>
          <input type="text" name="updates[]" value="{{ item.quantity }}">
          <input type="submit" value="{{ 'cart.update' | t }}">
        </td>
      </tr>
    {% endfor %}
  </table>

  <input type="submit" name="checkout" value="{{ section.settings.checkout_label }}">
</form>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.dispatchEvent(
      new CustomEvent('mono:funnel-track', {
        detail: {
          eventName: 'view_cart',
          payload: {
            funnel_step: 'cart',
            cart_item_count: {{ cart.item_count | json }},
            cart_total: {{ cart.total_price | money_without_currency | replace: ',', '.' | plus: 0 | json }}
          }
        }
      })
    );

    var checkoutButton = document.querySelector('input[name="checkout"]');
    if (checkoutButton) {
      checkoutButton.addEventListener('click', function () {
        document.dispatchEvent(
          new CustomEvent('mono:funnel-track', {
            detail: {
              eventName: 'begin_checkout',
              payload: {
                funnel_step: 'cart',
                cart_item_count: {{ cart.item_count | json }},
                cart_total: {{ cart.total_price | money_without_currency | replace: ',', '.' | plus: 0 | json }}
              }
            }
          })
        );
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "cart_reassurance",
      "label": "Cart reassurance",
      "default": "Paiement sécurisé et support disponible en cas de besoin."
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout label",
      "default": "Continuer vers le paiement"
    }
  ]
}
{% endschema %}
