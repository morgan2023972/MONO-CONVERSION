<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description | default: shop.description | default: shop.name
  assign robots_value = 'index,follow'
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_image = page_image

  if request.page_type == 'index'
    if settings.seo_funnel_home_title != blank
      assign seo_title = settings.seo_funnel_home_title
    endif
    if settings.seo_funnel_home_description != blank
      assign seo_description = settings.seo_funnel_home_description
    endif
  endif

  if request.page_type == 'product'
    if settings.seo_funnel_product_title_suffix != blank
      assign seo_title = seo_title | append: ' | ' | append: settings.seo_funnel_product_title_suffix
    endif
    if page_description == blank
      if settings.seo_funnel_product_description != blank
        assign seo_description = settings.seo_funnel_product_description
      endif
    endif
  endif

  if request.page_type == 'cart'
    if settings.seo_noindex_cart
      assign robots_value = 'noindex,nofollow'
    endif
  endif

  if settings.seo_funnel_og_image != blank
    if request.page_type == 'index'
      assign og_image = settings.seo_funnel_og_image
    endif
    if request.page_type == 'product'
      if page_image == blank
        assign og_image = settings.seo_funnel_og_image
      endif
    endif
  endif

  assign og_title = seo_title
  assign og_description = seo_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

<meta
  name="robots"
  content="{{ robots_value }}"
>

{%- if og_image -%}
  <meta
    property="og:image"
    content="https:{{ og_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ og_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ og_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- if og_image -%}
  <meta
    name="twitter:image"
    content="https:{{ og_image | image_url }}"
  >
{%- endif -%}

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
